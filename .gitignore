# Isolated worktrees materialize inside the repository; a commit made
# while one exists swallows the checkout, which has happened.
.claude/worktrees/

# The quarantined development guard (CLAUDE.md rule 1). Never tracked:
# this repository is the plugin's public install channel, and no later
# strip removes what an initial commit carries.
.claude/hooks/bash_guard.py

# Reviewer reports. Untracked and ignored, so a report never blocks the
# clean-tree preconditions the handover and approve rituals read.
.claude/reviews/

# Python
__pycache__/
*.py[cod]
.venv/
dist/
*.egg-info/

# Test, type and lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Machine-local, outside git by design. settings.local.json can carry
# local permission grants and is ignored here rather than relying on a
# machine's global gitignore, where a fresh clone would surface it as an
# untracked file and break the rituals' clean-tree preconditions.
CLAUDE.local.md
.claude/settings.local.json

# Ruled out of the repository at step 005 (D-025, D-026), and stripped
# from the published history in the same step. Both still exist on this
# machine and stay readable: the specification phase's own working
# history is CLAUDE.md rule 1's never-read directory, and the house
# harness conventions are supplied material rule 3 keeps read-only.
# Ignored here so neither can return to the index by accident.
.claude/spec-work/
.claude/refs/infra-conventions/
