{
  "autoMemoryEnabled": false,
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)",
      "Bash(git push --mirror:*)",
      "Bash(git push --delete:*)",
      "Bash(git push --prune:*)",
      "Bash(git filter-branch:*)",
      "Bash(git filter-repo:*)",
      "Bash(git reflog expire:*)",
      "Bash(git update-ref -d:*)",
      "Bash(git update-ref --stdin:*)"
    ],
    "ask": [
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Write(.claude/settings.local.json)",
      "Edit(.claude/hooks/**)",
      "Write(.claude/hooks/**)"
    ],
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(pip:*)",
      "Bash(pip3:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(shred:*)",
      "Bash(find:*)",
      "Bash(tee:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(ln:*)",
      "Bash(install:*)",
      "Bash(sed:*)",
      "Bash(truncate:*)",
      "Bash(just setup)",
      "Bash(just check)",
      "Bash(just check all)",
      "Bash(just check changed)",
      "Bash(just test)",
      "Bash(just verify)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sort:*)",
      "Bash(diff:*)",
      "Bash(cmp:*)",
      "Bash(md5sum:*)",
      "Bash(stat:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(date:*)",
      "Bash(jq:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(mktemp:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "g=\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/bash_guard.py\"; [ -x \"$g\" ] && exec \"$g\" || exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
